rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidUserProfile(data) {
      return data.email is string && data.email.size() > 3 && data.email.size() <= 100 &&
             data.username is string && data.username.size() >= 2 && data.username.size() <= 50 &&
             data.role is string &&
             data.subscription is string &&
             data.qrCodeId is string &&
             (!('createdAt' in data) || (data.createdAt is timestamp && data.createdAt <= request.time)) &&
             (!('updatedAt' in data) || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    function isValidUserTask(data) {
      return data.title is string && data.title.size() >= 1 && data.title.size() <= 200 &&
             data.isCompleted is bool &&
             (!('description' in data) || data.description is string) &&
             (!('category' in data) || data.category is string) &&
             (!('priority' in data) || data.priority is string) &&
             (!('createdAt' in data) || (data.createdAt is timestamp && data.createdAt <= request.time)) &&
             (!('updatedAt' in data) || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    function isValidUserNote(data) {
      return data.title is string && data.title.size() >= 1 && data.title.size() <= 200 &&
             data.content is string && data.content.size() <= 10000 &&
             (!('category' in data) || data.category is string) &&
             (!('createdAt' in data) || (data.createdAt is timestamp && data.createdAt <= request.time)) &&
             (!('updatedAt' in data) || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    function isValidAppUpdate(data) {
      return data.title is string && data.title.size() >= 1 && data.title.size() <= 200 &&
             data.version is string && data.version.size() <= 50 &&
             data.summary is string && data.summary.size() <= 2000 &&
             (!('createdAt' in data) || (data.createdAt is timestamp && data.createdAt <= request.time));
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUserProfile(request.resource.data);
      allow update: if isOwner(userId) && isValidUserProfile(request.resource.data);
      allow delete: if isOwner(userId);

      match /tasks/{taskId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidUserTask(request.resource.data);
        allow update: if isOwner(userId) && isValidUserTask(request.resource.data);
        allow delete: if isOwner(userId);
      }

      match /notes/{noteId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidUserNote(request.resource.data);
        allow update: if isOwner(userId) && isValidUserNote(request.resource.data);
        allow delete: if isOwner(userId);
      }

      match /notifications/{notificationId} {
        allow read, write: if isOwner(userId);
      }
    }

    match /app_updates/{updateId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && isValidAppUpdate(request.resource.data) && (request.auth.token.email == "damianblack68@gmail.com" || request.auth.uid != null);
      allow delete: if isAuthenticated() && request.auth.token.email == "damianblack68@gmail.com";
    }
  }
}
